<UserControl x:Class="ObdDiag.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:ObdDiag.App.Views">
    <UserControl.Resources>
        <views:BytesToImageConverter x:Key="BytesToImage" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="8,12,8,8" MaxWidth="760" HorizontalAlignment="Left">

            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="İŞLETME BİLGİLERİ (PDF raporun başlığında görünür)" Style="{StaticResource CardTitleStyle}" />

                    <TextBlock Text="İşletme adı *" Style="{StaticResource FieldLabelStyle}" />
                    <TextBox Text="{Binding WorkshopName, UpdateSourceTrigger=PropertyChanged}" MaxLength="150" />

                    <TextBlock Text="Adres" Style="{StaticResource FieldLabelStyle}" />
                    <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" MaxLength="300"
                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="40" MaxHeight="70" />

                    <UniformGrid Columns="2">
                        <StackPanel Margin="0,0,6,0">
                            <TextBlock Text="Telefon" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" MaxLength="50" />
                        </StackPanel>
                        <StackPanel Margin="6,0,0,0">
                            <TextBlock Text="E-posta" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" MaxLength="150" />
                        </StackPanel>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="LOGO" Style="{StaticResource CardTitleStyle}" />
                    <TextBlock Text="PNG veya JPG, en fazla 5 MB. Raporun sol üst köşesinde görünür."
                               Style="{StaticResource FieldLabelStyle}" />

                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Border Width="160" Height="90" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                                CornerRadius="6" Background="{StaticResource WindowBackgroundBrush}">
                            <Grid>
                                <Image Source="{Binding Logo, Converter={StaticResource BytesToImage}}"
                                       Stretch="Uniform" Margin="6" />
                                <TextBlock Text="Logo yok" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{StaticResource MutedTextBrush}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasLogo}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>

                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <Button Content="Logo Seç..." Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding ChooseLogoCommand}" />
                            <Button Content="Logoyu Kaldır" Margin="0,8,0,0" Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding RemoveLogoCommand}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <WrapPanel>
                <Button Content="Ayarları Kaydet" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,8"
                        Command="{Binding SaveCommand}" />
                <Button Content="Örnek Raporu Göster" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,8"
                        Command="{Binding PreviewCommand}" />
            </WrapPanel>

            <!-- Mesaj satırı -->
            <Border Padding="12,8" CornerRadius="6" Background="#E8EEF5">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Message}" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding Message}" TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsError}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
