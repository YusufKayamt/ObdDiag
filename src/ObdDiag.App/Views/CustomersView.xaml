<UserControl x:Class="ObdDiag.App.Views.CustomersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="0,12,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="8,0,8,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="*" MinWidth="320" />
                <ColumnDefinition Width="*" MinWidth="280" />
            </Grid.ColumnDefinitions>

            <!-- ============ Sol: müşteri listesi ============ -->
            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,8,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="MÜŞTERİLER" Style="{StaticResource CardTitleStyle}" />
                    <StackPanel Grid.Row="1" Margin="0,8,0,8">
                        <TextBlock Text="Ara (ad, telefon, plaka, şasi no)" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,2" />
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <ListBox Grid.Row="2" ItemsSource="{Binding Customers}" SelectedItem="{Binding SelectedCustomer}"
                             BorderThickness="0" Background="Transparent"
                             HorizontalContentAlignment="Stretch">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,3">
                                    <TextBlock Text="{Binding FullName}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Phone}" Foreground="{StaticResource MutedTextBrush}" FontSize="12" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Button Grid.Row="3" Content="+ Yeni Müşteri" Margin="0,8,0,0"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding NewCustomerCommand}" />
                </Grid>
            </Border>

            <!-- ============ Orta: müşteri bilgisi + araçlar ============ -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="0,0,8,0">
                <StackPanel>
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="MÜŞTERİ BİLGİSİ" Style="{StaticResource CardTitleStyle}" />

                            <TextBlock Text="Ad Soyad *" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Text="{Binding CustomerName, UpdateSourceTrigger=PropertyChanged}" MaxLength="200" />

                            <UniformGrid Columns="2">
                                <StackPanel Margin="0,0,6,0">
                                    <TextBlock Text="Telefon" Style="{StaticResource FieldLabelStyle}" />
                                    <TextBox Text="{Binding CustomerPhone, UpdateSourceTrigger=PropertyChanged}" MaxLength="50" />
                                </StackPanel>
                                <StackPanel Margin="6,0,0,0">
                                    <TextBlock Text="E-posta" Style="{StaticResource FieldLabelStyle}" />
                                    <TextBox Text="{Binding CustomerEmail, UpdateSourceTrigger=PropertyChanged}" MaxLength="200" />
                                </StackPanel>
                            </UniformGrid>

                            <TextBlock Text="Adres" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Text="{Binding CustomerAddress, UpdateSourceTrigger=PropertyChanged}" MaxLength="500" />

                            <TextBlock Text="Not" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Text="{Binding CustomerNotes, UpdateSourceTrigger=PropertyChanged}" MaxLength="1000"
                                     AcceptsReturn="True" TextWrapping="Wrap" MinHeight="40" MaxHeight="70"
                                     VerticalScrollBarVisibility="Auto" />

                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button Content="Müşteriyi Kaydet" Style="{StaticResource PrimaryButtonStyle}"
                                        Command="{Binding SaveCustomerCommand}" />
                                <Button Content="Müşteriyi Sil" Margin="8,0,0,0" Style="{StaticResource DangerButtonStyle}"
                                        Command="{Binding DeleteCustomerCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="ARAÇLAR" Style="{StaticResource CardTitleStyle}" />
                            <TextBlock Text="Seçili müşterinin araçları" Style="{StaticResource FieldLabelStyle}" />

                            <ListBox ItemsSource="{Binding Vehicles}" SelectedItem="{Binding SelectedVehicle}"
                                     MinHeight="56" MaxHeight="110">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,2">
                                            <TextBlock Text="{Binding Plate}" FontWeight="Bold" Margin="0,0,8,0" />
                                            <TextBlock Text="{Binding Make}" Margin="0,0,4,0" />
                                            <TextBlock Text="{Binding Model}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <TextBlock Text="Şasi No (VIN) * — 17 karakter, I/O/Q harfi yok" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Text="{Binding VehicleVin, UpdateSourceTrigger=PropertyChanged}" MaxLength="25"
                                     CharacterCasing="Upper" FontFamily="Consolas" />

                            <UniformGrid Columns="2">
                                <StackPanel Margin="0,0,6,0">
                                    <TextBlock Text="Plaka" Style="{StaticResource FieldLabelStyle}" />
                                    <TextBox Text="{Binding VehiclePlate, UpdateSourceTrigger=PropertyChanged}" MaxLength="20"
                                             CharacterCasing="Upper" />
                                </StackPanel>
                                <StackPanel Margin="6,0,0,0">
                                    <TextBlock Text="Model yılı" Style="{StaticResource FieldLabelStyle}" />
                                    <TextBox Text="{Binding VehicleYear, UpdateSourceTrigger=PropertyChanged}" MaxLength="4" />
                                </StackPanel>
                                <StackPanel Margin="0,0,6,0">
                                    <TextBlock Text="Marka" Style="{StaticResource FieldLabelStyle}" />
                                    <TextBox Text="{Binding VehicleMake, UpdateSourceTrigger=PropertyChanged}" MaxLength="100" />
                                </StackPanel>
                                <StackPanel Margin="6,0,0,0">
                                    <TextBlock Text="Model" Style="{StaticResource FieldLabelStyle}" />
                                    <TextBox Text="{Binding VehicleModel, UpdateSourceTrigger=PropertyChanged}" MaxLength="100" />
                                </StackPanel>
                            </UniformGrid>

                            <TextBlock Text="Not" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Text="{Binding VehicleNotes, UpdateSourceTrigger=PropertyChanged}" MaxLength="1000" />

                            <WrapPanel Margin="0,12,0,0">
                                <Button Content="Aracı Kaydet" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,4"
                                        Command="{Binding SaveVehicleCommand}" />
                                <Button Content="+ Yeni Araç" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,4"
                                        Command="{Binding NewVehicleCommand}" />
                                <Button Content="Aracı Sil" Style="{StaticResource DangerButtonStyle}" Margin="0,0,0,4"
                                        Command="{Binding DeleteVehicleCommand}" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ============ Sağ: tamir geçmişi ============ -->
            <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="TAMİR GEÇMİŞİ (seçili araç)" Style="{StaticResource CardTitleStyle}" />

                    <ListBox Grid.Row="1" ItemsSource="{Binding History}" Margin="0,8,0,8"
                             SelectedItem="{Binding SelectedHistoryItem}"
                             BorderThickness="0" Background="Transparent"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="0,6,0,8">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding DateText}" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" />
                                            <TextBlock Text="{Binding MileageText}" Margin="12,0,0,0" Foreground="{StaticResource MutedTextBrush}" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                        <TextBlock Text="{Binding CodesText}" TextWrapping="Wrap" Foreground="{StaticResource DangerBrush}"
                                                   FontFamily="Consolas" Margin="0,2,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CodesText}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding SnapshotText}" TextWrapping="Wrap" FontSize="12"
                                                   Foreground="{StaticResource MutedTextBrush}" Margin="0,2,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SnapshotText}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Grid.Row="2">
                        <Button Content="Seçili Kaydın PDF Raporunu Al" HorizontalAlignment="Stretch" Margin="0,0,0,8"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding ExportReportCommand}" />
                        <Border BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,1,0,0" Margin="0,0,0,4" />
                        <TextBlock Text="Elle tamir kaydı ekle" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox Text="{Binding NewRepairDescription, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="48" MaxHeight="80"
                                 VerticalScrollBarVisibility="Auto" />
                        <DockPanel Margin="0,8,0,0">
                            <TextBlock DockPanel.Dock="Left" Text="Km:" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBox DockPanel.Dock="Left" Width="90" Text="{Binding NewRepairMileage, UpdateSourceTrigger=PropertyChanged}" />
                            <Button DockPanel.Dock="Right" Content="Kaydı Ekle" Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding AddRepairCommand}" />
                        </DockPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Mesaj satırı -->
        <Border Grid.Row="1" Margin="8,0,8,8" Padding="12,8" CornerRadius="6" Background="#E8EEF5">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Message}" Value="">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding Message}" TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsError}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Border>
    </Grid>
</UserControl>
